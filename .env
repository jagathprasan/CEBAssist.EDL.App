# CEBAssist EDL mobile client
#
# Leave API_BASE_URL unset to use the live server:
#   https://edl.cebassist.lk
#
# Uncomment ONE line when you need to test against a local aggregator.
# Android emulator (host machine):
# API_BASE_URL=http://10.0.2.2:8092
# Desktop, iOS simulator, or a phone on the same network as this PC:
# API_BASE_URL=http://localhost:8092
